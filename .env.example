# Copy to .env and fill in. Never commit .env.

# Signs JWTs and password-reset tokens: a long random string
SECRET_KEY=
# True also enables /docs and the /api/v1/debug/* routes (from this computer
# only); keep False outside development
DEBUG=False

# Error tracking (sentry.io): paste the project's DSN to send server errors
# there. Empty = off. Use SENTRY_ENVIRONMENT=development on a laptop.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# PostgreSQL
POSTGRES_DB=mukham_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# AWS: Rekognition (face match and liveness) and S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
# Cognito identity pool for the mobile app's face check (guest credentials)
AWS_IDENTITY_POOL_ID=
# Optional private bucket for photos and face images; empty = local folders
MEDIA_S3_BUCKET=

# Web app and mobile app (dev server on 8081) origins, comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
# Links in password-reset emails point here
FRONTEND_URL=http://localhost:3000

# Resend SMTP, for password-reset emails. The default sender,
# onboarding@resend.dev, only delivers to the Resend account's own email:
# verify your domain in Resend and set a sender on it to email anyone.
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Mukham <no-reply@yourdomain.com>

# Sessions: how long a signed-in device may stay idle
REFRESH_TOKEN_EXPIRE_DAYS=30
# Mobile app versions below this must update
MIN_APP_VERSION=1.0.0

# Address search for office locations, through OpenStreetMap's Nominatim.
# False switches it off without an app update. Their policy wants the
# app's name and a contact address in the User-Agent.
GEOCODING_ENABLED=True
GEOCODING_USER_AGENT=Mukham/1.0 (you@example.com)

# Push notifications through Expo. The access token comes from
# expo.dev > Account settings > Access tokens; keep it secret.
EXPO_ACCESS_TOKEN=
NOTIFICATIONS_ENABLED=True
SHIFT_REMINDER_MINUTES=15
CHECKOUT_REMINDER_MINUTES=60
REMINDER_DAYS_OFF=sat,sun

# Limits on repeated sign-in, sign-up, password-reset and face-check requests
RATE_LIMIT_ENABLED=True
